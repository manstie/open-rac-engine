// How pickups move, and what crates and the vendor give (PLAN.md P1.10): the bolts,
// nanotech and ammo that crates and dead enemies leave. They pop out, bounce, and fly to a
// hero who comes near, as UYA's do; the numbers are guesses to tune by play [placeholder].
// The rounds an ammo pickup holds and the vendor's price a round are each gun's
// (uya_weapons.ron's pickup_rounds and round_price).
//
// Units: u, u/s and u/s², ticks at 60 Hz.
(
    gravity: 30.0,
    radius: 0.15,
    bounce: 0.4,
    rest_speed: 1.5,
    ground_brake: 8.0,
    pop_speed: (1.5, 3.5),
    pop_lift: (5.0, 7.5),
    magnet_delay_ticks: 24, // long enough to see them land
    magnet_radius: 6.0,
    fly_speed: 4.0,
    fly_accel: 60.0,
    collect_radius: 0.6,
    life_ticks: 1800,
    blink_ticks: 180,
    // UYA's crates aren't read [placeholder].
    crates: (
        bolts: (4, 7),
        bolt_value: 5,
        ammo_pickups: 2,
    ),
    // A round every 3 ticks: the N60's 150 in 7.5 s [placeholder].
    vendor: (round_ticks: 3),
)
