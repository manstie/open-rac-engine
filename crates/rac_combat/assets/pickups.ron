// How pickups move, and what crates and the vendor give (PLAN.md P1.10): the bolts,
// nanotech and ammo that crates and dead enemies leave. Sources are sections of
// docs/research/weapons.md, labelled as in uya_weapons.ron; how they pop out and bounce,
// and how bolts and nanotech fly in, are guesses to tune by play [placeholder]. The rounds
// an ammo pickup holds and the vendor's price a round are each gun's (uya_weapons.ron's
// pickup_rounds and round_price).
//
// Units: u, u/s and u/s², ticks at 60 Hz.
(
    gravity: 30.0,
    radius: 0.15,
    bounce: 0.4,
    rest_speed: 1.5,
    ground_brake: 8.0,
    pop_speed: (1.5, 3.5),
    pop_lift: (5.0, 7.5),
    // "Ammo pickups, crates and the vendor": pickup_radius and pickup_height without the
    // Bolt Grabber V2, from his feet [code].
    reach: 8.7,
    reach_height: 3.0,
    magnet_delay_ticks: 24, // long enough to see them land
    fly_speed: 4.0,
    fly_accel: 60.0,
    collect_radius: 0.6,
    life_ticks: 1800,
    blink_ticks: 180,
    // "Ammo pickups, crates and the vendor" [code]: taken at once 2 u below where it was
    // thrown; flying in from rest, 0.00667 u a frame faster each frame up to 1.0667 u a
    // frame, to 0.7 u above his feet, shrinking over its last 30 frames.
    ammo: (
        fall: 2.0,
        accel: 24.0,
        top_speed: 64.0,
        height: 0.7,
        shrink_ticks: 30,
    ),
    crates: (
        // Veldin's bolt crates hold 11, 44 or 61 [data].
        bolts: 44,
        // `crate_drop`: at most 2 or 3 coins while few crates have broken lately, the
        // rest banked ("The bolt bank") [code].
        most_coins: (2, 3),
        // `ammo_crate_pick`: 2 pickups once in 5 [code].
        two_pickups_in: 5,
        // `crate_drop`: the doubler adds 1800 frames to the bolt multiplier's [code].
        doubler_ticks: 1800,
    ),
    // The nanotech crate's orbs (`nanotech_holder_update`) [code]: let out once it is broken
    // to a hero within 10 u whose health with what orbs in flight carry is under his most,
    // each flies 20-80 frames on a curve bowed out 5 u square to his way, fanned 25.7°
    // apart, to 0.75 u above his feet; the first to arrive heals him his most / 5, / 4
    // with the help measure at 100 and / 3 at 200 ("The help measure"), and they go 300
    // frames after. Before that they circle the crate's middle 0.3 u out, 3° a frame
    // [placeholder].
    nanotech: (
        reach: 10.0,
        divisors: (5, 4, 3),
        orbs: 8,
        flight: (20, 80),
        bow: 5.0,
        fan: 25.7,
        height: 0.75,
        life: 300,
        ring: 0.3,
        spin: 3.0,
    ),
    // The explosive crate (`crate_update`) [code]: touched, it goes off in 179 frames,
    // hit in 5-14 (a random 5 to 15, cut), set off by a blast in 1. Its blast grows over 20
    // frames, to 2 u round its middle for targets, which take 2.0, and 3 u for heroes,
    // who take 4 pushed 1 u a frame out and up (which their hit caps). A hero touches it
    // within 0.05 u [placeholder].
    explosive: (
        touched_ticks: 179,
        hit_ticks: (5, 14),
        blast_ticks: 20,
        reach: 2.0,
        damage: 2.0,
        hero_reach: 3.0,
        hero_damage: 4,
        push: 60.0,
        lift: 60.0,
        touch: 0.05,
    ),
    // The vendor's menu ("The vendor's menu") [code]: held Left or Right steps between
    // rows again past 15 ticks on each 1 modulo 10, and changes the count of rounds again
    // past 15 on each multiple of 8 and on every tick past 47. Upgrades to Mega are UYA's
    // in challenge mode only. The stick's push that counts as Left or Right is the
    // kit's [placeholder].
    vendor: (
        row_after: 15,
        row_every: 10,
        count_after: 15,
        count_every: 8,
        count_fast_after: 47,
        stick: 64,
        upgrades: false,
    ),
)
