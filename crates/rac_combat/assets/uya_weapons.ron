                        speed: (4.0, 9.0),
                        radius: 0.125,
                        bounce: (keep: 0.95, home_range: Some(7.0), home_speed: 4.0),
                        life: (240, 360),
                        armed_ticks: 70,
                        hit_radius: 2.0,
                    ))),
                    (2, (count: 6, share: 0.1, gravity: 14.58, bomblet: (
                        up_degrees: (50.0, 90.0),
                        speed: (4.0, 9.0),
                        radius: 0.125,
                        bounce: (keep: 0.95, home_range: Some(7.0), home_speed: 4.0),
                        life: (240, 360),
                        armed_ticks: 70,
                        hit_radius: 2.0,
                    ))),
                    (3, (count: 6, share: 0.1, gravity: 14.58, bomblet: (
                        up_degrees: (40.0, 75.0),
                        speed: (4.0, 12.0),
                        radius: 0.25,
                        bounce: (keep: 0.95, home_range: Some(7.0), home_speed: 4.0),
                        life: (240, 360),
                        armed_ticks: 70,
                        hit_radius: 7.0,
                    ))),
                    (4, (count: 0, share: 0.0, gravity: 14.58, bomblet: (
                        up_degrees: (0.0, 0.0),
                        speed: (0.0, 0.0),
                        radius: 0.0,
