            mods: (lock_on: Some(3), shock: Some(2)), // V4, V3 [code]
            fire: Homing((
                rate: 1.7,
                assist: (range: 30.0, near: (18.0, 17.0), far: (18.0, 17.0)),
                aimed_assist: (range: 30.0, near: (18.0, 4.0), far: (18.0, 4.0)),
                assist_height: 0.75,
                pick_ticks: 5,
                drop_ticks: 5,
                near_radius: 1.0,
                near_ahead: 1.0, // "just ahead of the barrel" [placeholder]
                speed: 60.0, // +0x4C
                lifetime: 75,
                homing_ticks: 294,
                turn_degrees: 6.0, // [placeholder]: how it turns isn't read
                push: 1.5,
                blast_radius: 0.75,
            )),
            effects: (fire: Some("annihilator.fire"), impact: Some("annihilator.blast")),
        ),
        // "Flux Rifle (0x345350, shot 0x3463A0)" [code].
        (
            name: "Flux Rifle",
            upgraded_name: "Splitter Rifle",
            item: 0x6F,
            pickup_rounds: 1,
            held: false,
            steady: false,
            ready_ticks: 23, // [placeholder]: not read for this gun
            fire_ticks: 30, // [placeholder]
            look_wait_ticks: 0,
            // "The hero's side of firing": rows +0x18, +0x24, +0x28, +0x2C [data].
            pose: (hold: TwoHands, standing: Some(49), crouched: Some(65)),
            levels: [
                (damage: 15.0, ammo: 10, xp: 200, round_price: 50),
                (damage: 20.0, ammo: 12, xp: 600, round_price: 50),
                (damage: 25.0, ammo: 12, xp: 1500, round_price: 50),
