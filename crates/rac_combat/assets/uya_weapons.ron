// The guns of Ratchet & Clank: Up Your Arsenal (NTSC-U, SCUS-97353): the hero kit's
// default weapons.
//
// Units: u, u/s and u/s², ticks at 60 Hz. Sources are sections of
// docs/research/weapons.md, with its labels: [code] read in the game's code, [data] read
// from the weapon table in a memory image, [text] said by the vendor's descriptions,
// [verified] checked in our traces, [placeholder] not found in the game yet: a guess to be
// replaced. Levels are V1 to V5, then Mega, Giga and Omega; "level 2" in a mod or a
// ByLevel entry is V3.
(
    name: "UYA NTSC-U",
    rules: (
        // "Checked in traces": the gun was in his hand 17 frames after Circle [verified].
        draw_ticks: 17,
        // "Switching and firing": Triangle let go within 20 frames, round the three most
        // recent of eight guns [code].
        quick_switch_ticks: 20,
        quick_switch_guns: 3,
        recent_guns: 8,
        bought_level: 5, // "Owning, ammo, levels and XP": Mega is bought [code]
        // where his hand is as a gun fires, right, up and forward of his feet
        // [computed from the hero's sequences on the disc, checked against the firing
        // traces]. Standing, as a gun first fires from its rest, the barrel rises 0.2 u a
        // unit along it; once it fires the hand follows the standing sequence: 49 at its
        // middle keyframes, 51 and 46 about a hold, and 103 as the Shock Blaster's rays
        // leave, 5 frames after its press (its rise taken into the place). A glove lets go
        // 20 frames into its 41, or its arms' 61 [code].
        hands: (
            ready: (0.3, 0.56, 0.05),
            ready_slope: 0.2,
            firing: [
                (49, (0.26, 0.43, -0.23)),
                (51, (0.26, 0.6, 0.53)),
                (46, (0.2, 0.3, 0.38)),
                (103, (0.3, 0.58, -0.2)),
            ],
            moving: (0.29, 0.59, 0.09), // traced, walking
            air: (0.32, 0.77, 0.1), // traced, jumping
            crouched: [(65, (0.33, 0.26, 0.02)), (57, (0.33, 0.3, 0.4))],
            thrown: (-0.18, 0.8, 1.01),
            thrown_moving: (0.05, 0.78, 0.43),
            thrown_crouched: (0.05, 0.48, 0.43), // 61's hand, lowered as he crouches [simplified]
        ),
        // "How guns aim with it": aim_bend_to_point's 80°, a tenth within 4 u; the aim
        // point is where the camera's 30 u line meets something (fps_cam_find_target)
        // [code].
        view_range: 30.0,
        bend_degrees: 80.0,
        bend_near: 4.0,
        // "What shock and acid do" [code]: the first other living enemy in sight within
        // 8 u, a quarter of the gun's damage for the guns here, reached in 10 frames.
        shock: (range: 8.0, share: 0.25, reach_ticks: 10),
        acid_slots: 30,
        // "The quick-select ring" [code], as with QUICK SELECT PAUSE off: the hero's input
        // held 15 ticks after the press (27 after a tap that switched nothing); picking
        // after the hold check; a 30-tick lock-out for a stick already pushed; picks past
        // 0.9 of full, kept within 33.75°, straight slots 27° of 45°; 8 ticks to open and
        // to close; R1 keeps the second ring up 15 ticks.
        // "Aim indicators": the wrench in the look draws 0x25, 40 px, blue-grey, no pulse
        // [code].
        wrench_sight: Some((
            texture: 0x25,
            size: (40.0, 40.0),
            red_above: None,
            pulse: false,
            colour: Some((0.8, 0.89, 1.0)),
            when: Look,
        )),
        ring: (
            input_delay_ticks: 15,
            input_delay_after_tap_ticks: 27,
            hold_ticks: 6,
            lock_out_ticks: 30,
            pick: 0.9,
            release: 0.5,
            keep_degrees: 33.75,
            cardinal_share: 0.6,
            open_ticks: 8,
            ring_two_ticks: 15,
        ),
    ),
    weapons: [
        // "Shock Blaster (0x36A790)" [code; firing verified on UYA NTSC].
        (
            name: "Shock Blaster",
            upgraded_name: "Shock Cannon",
            item: 0x27,
            // "Numbers": the gun's price, then its Mega upgrade's (rows +0x7C) [data]; the
            // Shock Blaster and Nitro Launcher are given, not sold.
            price: 0,
            upgrade_price: 420000,
            // "Ammo pickups, crates and the vendor": the rounds in each pickup an ammo crate
            // throws out (row +0x88), and each level's round_price, the vendor's price a
            // round (+0x84) [data].
            pickup_rounds: 4,
            held: false,
            steady: true,
            ready_ticks: 19, // the gun out 23 frames [code]
            // Sequence 103 as played: the 2 frames' blend, then 45 keyframes of 2 [data]; the
            // trace kept it 59 frames without another shot.
            fire_ticks: 92,
            look_wait_ticks: 40,
            // "The hero's side of firing": rows +0x18, +0x24, +0x28, +0x2C [data].
            pose: (hold: TwoHands, standing: Some(103)),
            muzzle: [(0, (0.33, 0.95)), (4, (0.13, 0.73))], // point 0 [data]
            levels: [ // "Numbers" [data]
                (damage: 2.0, ammo: 30, xp: 150, round_price: 5),
                (damage: 2.5, ammo: 35, xp: 400, round_price: 5),
                (damage: 3.0, ammo: 40, xp: 700, round_price: 5),
                (damage: 4.0, ammo: 40, xp: 1000, round_price: 5),
                (damage: 5.0, ammo: 50, xp: 0, round_price: 5),
                (damage: 55.0, ammo: 50, xp: 10000, round_price: 5),
                (damage: 70.0, ammo: 55, xp: 25000, round_price: 5),
                (damage: 105.0, ammo: 60, xp: 0, round_price: 5),
            ],
            mods: (lock_on: Some(2), shock: Some(3)), // V3, V4 [code]
            fire: Hitscan((
                rate: 2.0, // +0x50
                hit_ticks: 2,
                busy_hit_ticks: 5,
                after_hit_ticks: 20,
                ball_radius: 1.5,
                ball_push: 1.75, // [code]
                ray_length: 32.0,
                falloff: [(10.0, 0.75), (14.0, 0.5), (20.0, 0.125)], // 0x36B888 [code]
                random_rays: [(0, 20), (4, 23)], // the Shock Cannon's 0x385948
                spread_degrees: 17.0,
                down_rays: 3,
                down_degrees: 15.0,
                down_spread_degrees: 20.0,
                push: 1.5, // each ray's, along it [code]
                charge: Some((from_level: 1, try_ticks: 20, ticks: 78, damage_scale: 3.0)),
            )),
            effects: "shock_blaster",
            // "Aim indicators" [code, data].
            sight: (crosshair: Some((texture: 0x5B, size: (30.0, 55.0), turn_degrees: 90.0, red_above: Some(0.95), when: Aiming))),
        ),
        // "N60 Storm (0x3A5928, bullets 0x35B390)" [code; firing verified on UYA NTSC].
        (
            name: "N60 Storm",
            upgraded_name: "N90 Hurricane",
            item: 0x2F,
            price: 15000,
            upgrade_price: 460000,
            pickup_rounds: 15,
            held: true,
            steady: true,
            ready_ticks: 19, // the gun out 23 frames [code]
            fire_ticks: 1, // held: it fires until let go, whatever this [code]
            look_wait_ticks: 0,
            // "The hero's side of firing": rows +0x18, +0x24, +0x28, +0x2C [data].
            pose: (hold: OneHand, standing: Some(51), crouched: Some(57)),
            muzzle: [(0, (0.2, 0.6))], // its code's two points, side by side (`barrels`) [code]
            levels: [
                (damage: 1.5, ammo: 150, xp: 200, round_price: 2),
                (damage: 1.75, ammo: 175, xp: 500, round_price: 2),
                (damage: 2.0, ammo: 200, xp: 1500, round_price: 2),
                (damage: 2.5, ammo: 225, xp: 3300, round_price: 2),
                (damage: 3.5, ammo: 300, xp: 0, round_price: 2),
                (damage: 35.0, ammo: 300, xp: 15000, round_price: 2),
                (damage: 50.0, ammo: 350, xp: 37500, round_price: 2),
                (damage: 60.0, ammo: 400, xp: 0, round_price: 2),
            ],
            mods: (lock_on: Some(2), shock: Some(3)),
            fire: Projectile((
                timing: Repeat(14), // its own interval, not +0x50's 7 [verified]
                speed: (60.0, 80.0),
                lifetime: [(0, 30), (1, 46)],
                bounce_from: Some(1),
                world_radius: 0.6,
                target_radius: 1.0,
                muzzle_ball: 0.0,
                // Two muzzle points in turn (0x1DE340, then 0x1DE350): 0.2 u either side of
                // the barrel [code; which side is his right isn't sure].
                barrels: [(0.2, 0.0, 0.0), (-0.2, 0.0, 0.0)],
                assist: Some((range: 35.0, near: (45.0, 45.0), far: (3.0, 6.0))),
                scope: None,
                push: 0.58, // half its velocity a frame, 0.5–0.67 by its speed [code]
                hurricane: Some((
                    from_level: 4,
                    repeat_ticks: 10,
                    reach: 30.0,
                    extra_ticks: 30,
                    bounces: 7,
                )),
            )),
            effects: "n60",
            // "Aim indicators" [code, data].
            sight: (
                crosshair: Some((texture: 0x56, size: (30.0, 30.0), red_above: Some(0.99), when: AimingUnlocked)),
                mark: Target(or_lock: true, follow_only: true, outside_look: true),
            ),
        ),
        // "Nitro Launcher (0x36E360, charge 0x361218, blast 0x35E718)" [code].
        (
            name: "Nitro Launcher",
            upgraded_name: "Nitro Eruptor",
            item: 0x77,
            price: 0,
            upgrade_price: 380000,
            pickup_rounds: 1,
            held: false,
            steady: false,
            ready_ticks: 19, // the gun out 23 frames [code]
            fire_ticks: 21, // hero_fire_stop once it has played over 20 frames [code, traced]
            look_wait_ticks: 40,
            // "The hero's side of firing": rows +0x18, +0x24, +0x28, +0x2C [data].
            pose: (hold: TwoHands, standing: Some(49), crouched: Some(65)),
            muzzle: [(0, (0.18, 0.82)), (4, (0.18, 0.99))], // point 0 [data]
            levels: [
                (damage: 10.0, ammo: 8, xp: 200, round_price: 50),
                (damage: 12.0, ammo: 8, xp: 500, round_price: 50),
                (damage: 15.0, ammo: 10, xp: 1100, round_price: 50),
                (damage: 20.0, ammo: 10, xp: 2600, round_price: 50),
                (damage: 40.0, ammo: 12, xp: 0, round_price: 50),
                (damage: 210.0, ammo: 12, xp: 7500, round_price: 50),
                (damage: 250.0, ammo: 14, xp: 20000, round_price: 50),
                (damage: 300.0, ammo: 16, xp: 0, round_price: 50),
            ],
            // Acid from V2 does nothing as read: its blast names an item with no entry in
            // the acid table, so it has no `acid` here.
            mods: (lock_on: Some(2), acid: Some(1)),
            fire: Lobbed((
                rate: 0.5,
                lock_range: 12.0,
                assist: (range: 11.1, near: (0.0, 0.0), far: (22.5, 90.0)),
                reach: 12.0,
                ground_speed: 12.5,
                aim_gravity: 16.0,
                max_launch: 30.0, // 0.5 u a frame
                cut_launch: 22.0,
                tilt: Some((from_level: 4, down_degrees: 5.0, aimed_up_degrees: 10.0)),
                gravity: 12.0,
                target_radius: 1.5,
                fuse_ticks: 10,
                ground_after_ticks: 40,
                ground_probe: 1.0,
                lifetime: 300, // the kit's own: the game's charge has none [code]
                blast: (
                    flash_ticks: 12,
                    grow_ticks: 20,
                    radius_from: 2.0,
                    radius_to: [(0, 6.0), (3, 7.0)],
                    push: 1.5,
                    // The Nitro Eruptor (0x38A7B8) [code].
                    eruption: Some((
                        from_level: 4,
                        wait_ticks: 18,
                        grow_ticks: 30,
                        radius: (3.0, 11.0),
                        push: 1.5,
                        // "Infector", V5: as it bursts, 15 small bullets of a flat 10 at
                        // 20-30 u/s, one at each target farther than 8 u of up to 10 within
                        // 13 u, the rest any way round, 20° down to 15° up [code].
                        spray: Some((
                            count: 15,
                            damage: 10.0,
                            speed: (20.0, 30.0),
                            near: 8.0,
                            within: 13.0,
                            aimed: 10,
                            down_degrees: 20.0,
                            up_degrees: 15.0,
                        )),
                    )),
                ),
            )),
            effects: "nitro",
        ),
        // "Lava Gun (0x303F88, stream 0x304A18)" [code].
        (
            name: "Lava Gun",
            upgraded_name: "Liquid Nitrogen Gun",
            item: 0x11,
            price: 40000,
            upgrade_price: 260000,
            pickup_rounds: 15,
            held: true,
            steady: true,
            ready_ticks: 0, // its code doesn't wait for the gun to be out [code]
            fire_ticks: 1, // held: it fires until let go, whatever this [code]
            look_wait_ticks: 0,
            // "The hero's side of firing": rows +0x18, +0x24, +0x28, +0x2C [data].
            pose: (hold: TwoHands, standing: Some(49), crouched: Some(65)),
            muzzle: [(0, (0.23, 1.09)), (4, (0.05, 1.15))], // point 0 [data]
            levels: [
                (damage: 8.0, splash: 8.0, ammo: 150, xp: 600, round_price: 1),
                (damage: 12.0, splash: 12.0, ammo: 150, xp: 1500, round_price: 3),
                (damage: 18.0, ammo: 175, xp: 2700, round_price: 3),
                (damage: 25.0, ammo: 175, xp: 4200, round_price: 3),
                (damage: 35.0, ammo: 200, xp: 0, round_price: 3),
                (damage: 130.0, ammo: 200, xp: 10000, round_price: 3),
                (damage: 150.0, ammo: 250, xp: 25000, round_price: 3),
                (damage: 180.0, ammo: 300, xp: 0, round_price: 3),
            ],
            // Lock-on from V3 [code]; acid from V2 [text].
            mods: (lock_on: Some(2), acid: Some(1)),
            // "What shock and acid do": bank 1 at V3 and V4, bank 0 otherwise [code, data].
            acid: [
                (0, (per_second: 2.0, seconds: 4.0)),
                (2, (per_second: 3.0, seconds: 6.0)),
                (4, (per_second: 2.0, seconds: 4.0)),
            ],
            fire: Stream((
                full: 10.0,
                rise: (gain: 0.0075, damping: 0.002),
                fall: (gain: 0.06, damping: 0.01),
                ammo_ticks: 10,
                points: 35,
                speed_per_strength: 3.0, // 0.05 u a frame
                raise: 0.02,
                moving_tilt_degrees: 5.6,
                lifetime: 40,
                gravity: 21.6,
                splash_radius: 1.5,
                nozzle_radius: 0.5,
                freezes_from: Some(4),
            )),
            effects: "lava",
        ),
        // "Annihilator (0x36D5A0, missile 0x396A20)" [code].
        (
            name: "Annihilator",
            upgraded_name: "Decimator",
            item: 0x3F,
            price: 150000,
            upgrade_price: 580000,
            pickup_rounds: 2,
            held: false,
            steady: false,
            ready_ticks: 24, // the gun out 28 frames [code]
            fire_ticks: 66, // sequence 49 as played: the 2 frames' blend, then 16 keyframes of 4 [data]
            look_wait_ticks: 0,
            // "The hero's side of firing": rows +0x18, +0x24, +0x28, +0x2C [data].
            pose: (hold: TwoHands, standing: Some(49), crouched: Some(65)),
            muzzle: [(0, (0.22, 1.1))], // point 0 [data]
            levels: [
                (damage: 25.0, splash: 6.0, ammo: 20, xp: 800, round_price: 20),
                (damage: 30.0, splash: 6.0, ammo: 20, xp: 2400, round_price: 20),
                (damage: 40.0, splash: 6.0, ammo: 22, xp: 6400, round_price: 20),
                (damage: 55.0, splash: 6.0, ammo: 22, xp: 12400, round_price: 20),
                (damage: 70.0, splash: 6.0, ammo: 25, xp: 0, round_price: 20),
                (damage: 150.0, splash: 6.0, ammo: 25, xp: 10000, round_price: 20),
                (damage: 200.0, splash: 6.0, ammo: 28, xp: 25000, round_price: 20),
                (damage: 250.0, splash: 6.0, ammo: 30, xp: 0, round_price: 20),
            ],
            mods: (lock_on: Some(3), shock: Some(2)), // V4, V3 [code]
            fire: Homing((
                rate: 1.7,
                assist: (range: 30.0, near: (18.0, 17.0), far: (18.0, 17.0)),
                aimed_assist: (range: 30.0, near: (18.0, 4.0), far: (18.0, 4.0)),
                assist_height: 0.75,
                pick_ticks: 5,
                drop_ticks: 5,
                near_radius: 1.0,
                // 1 u along the barrel from the gun's origin [code], which is 0.1 u short of
                // its muzzle.
                near_ahead: -0.1,
                speed: 60.0, // +0x4C
                lifetime: 75,
                leash: 75.0, // [code]
                push: 1.5,
                blast_radius: 0.75,
                // "Annihilator": the blast's mines, the Bouncer's bomblets (gravity, life,
                // bounce and arming as theirs) at a tenth of the damage: 4 at V2, 6 at V3,
                // 6 heavy at V4, none from V5 [code].
                mines: [
                    (1, (count: 4, share: 0.1, gravity: 14.58, bomblet: (
