                (damage: 55.0, splash: 6.0, ammo: 22, xp: 12400, round_price: 20),
                (damage: 70.0, splash: 6.0, ammo: 25, xp: 0, round_price: 20),
                (damage: 150.0, splash: 6.0, ammo: 25, xp: 10000, round_price: 20),
                (damage: 200.0, splash: 6.0, ammo: 28, xp: 25000, round_price: 20),
                (damage: 250.0, splash: 6.0, ammo: 30, xp: 0, round_price: 20),
