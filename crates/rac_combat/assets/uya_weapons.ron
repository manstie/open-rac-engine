            sight: (
                scope: Some((
                    reach: 128.0,
                    narrowest: [(0, 20.0), (2, 10.0)],
                    zoom_step: 0.01,
                    start_share: 0.25,
                    zoom_in: (gain: 0.02, damping: 0.2),
                    zoom_out: (gain: 0.005, damping: 0.2),
                )),
            ),
        ),
        // UYA's other fourteen guns, read in code at the level of their firing and their
