// The demo's HUD (PLAN.md P1.12) and quick-select ring (P1.9): where things go, when they
// show, and each gun's icon. When the parts show follows UYA ("The HUD" in
// docs/research/weapons.md; its 60 Hz frames as seconds) [code]; the layout, colours and
// icons are the demo's own, and no game art is used. The icons are coloured shapes with
// letters.
//
// Units: logical pixels and seconds; colours are sRGB, 0 to 1.
(
    margin: 20.0, // from the screen's edges
    text: (1.0, 0.95, 0.8),
    text_size: 20.0,
    small_size: 15.0,
    panel: (0.05, 0.06, 0.1, 0.55), // behind each group, with its alpha
    // How bright a gun out of ammo is drawn in the ring, and the gun shown a moment after
    // it goes away.
    dimmed: 0.45,
    // "The HUD" [code]: the gun 10 frames after it goes away; health 720 frames after a
    // kill and 360 after damage, nanotech or the ring; bolts 180; under 15% health stays up
    // and pulses, and ammo pulses, every 40 frames; the bolt tally fades in over 15
    // frames, and 61 frames after the last change rolls in over 15. A help message's box
    // opens over 9 frames, shows its text 4 frames and 7 a character, and closes over 8.
    timings: (
        gun_after: 0.1667,
        health_after_kill: 12.0,
        health_after_change: 6.0,
        bolts_after: 3.0,
        low_share: 0.15,
        pulse: 0.6667,
        tally_fade: 0.25,
        tally_wait: 1.0167,
        tally_roll: 0.25,
        help_open: 0.15,
        help_lead: 0.0667,
        help_per_char: 0.1167,
        help_close: 0.1333,
    ),

    // UYA's nanotech: a pip a point up to `most_pips`, then each pip a share of the most.
    health: (
        pip: (12.0, 20.0),
        gap: 3.0,
        most_pips: 20,
        full: (0.35, 0.85, 1.0),
        lost: (0.15, 0.2, 0.28),
    ),

    bolts: (
        icon: 16.0,
        colour: (1.0, 0.82, 0.3),
        size: 24.0,
        // The tally beside the count: gains and losses.
        gain: (0.55, 1.0, 0.55),
        loss: (1.0, 0.45, 0.35),
        // The doubler's x2 at rest, in UYA's colours, pulsing by its code's steps.
        times_size: 24.0,
    ),

    gun: (
        icon: 56.0,
        name_size: 21.0,
        ammo_size: 26.0,
        xp: (170.0, 6.0), // the XP bar's width and height
        xp_colour: (0.55, 0.95, 0.45),
        xp_back: (0.2, 0.22, 0.25),
        // The next two recent guns beneath, smaller and fainter, as UYA shows them.
        recent: 30.0,
        recent_alpha: 0.5,
    ),

    // What low health and low ammo pulse to: UYA's dark red.
    pulse_colour: (0.6, 0.05, 0.05),
    // A gun out of ammo picked in the ring.
    empty_colour: (1.0, 0.3, 0.25),
    // Ammo going up (a pickup) lights the count for this long.
    ammo_flash_seconds: 0.5,
    ammo_flash_colour: (0.55, 1.0, 0.55),
    // A gun's level up stays on screen this long, fading over its last half second
    // ("The HUD": 180 frames [code]).
    level_up_seconds: 3.0,
    level_up_colour: (0.55, 0.95, 0.45),
    // Brought back after a death or a fall out of the level, UYA's screen is black and
    // clears by 1/8 a frame ("Getting hit and dying" [verified on UYA NTSC]).
    respawn_fade_seconds: 0.1333333,
    // A help message, high in the middle (UYA's are low, where the app's controls are):
    // its words' size, UYA's colour for them, and the widest its box grows ("Help
    // messages" [code]).
    help: (
        size: 18.0,
        colour: (1.0, 0.8, 0.4),
        width: 560.0,
    ),

    // The ring round the middle of the screen, slot 0 at the top and the rest clockwise.
    ring: (
        radius: 130.0,
        slot: 66.0,
        icon: 40.0,
        back: (0.05, 0.06, 0.1, 0.45),
        slot_back: (0.1, 0.12, 0.18, 0.85),
        edge: (0.45, 0.5, 0.6),
        highlight: (1.0, 0.82, 0.3),
        // The highlighted slot is drawn this much bigger.
        highlight_scale: 1.15,
    ),

    // A gun's shape follows how it fires; its colour and letters are its own.
    shapes: (
        hitscan: Diamond,
        projectile: Bar,
        lobbed: Circle,
        stream: Ring,
        homing: Square,
    ),
    // By each gun's V1 name. A gun missing here is drawn grey with its initials.
    icons: {
        "Shock Blaster": (colour: (0.45, 0.8, 1.0), mark: "SB"),
        "N60 Storm": (colour: (1.0, 0.82, 0.3), mark: "N60"),
        "Nitro Launcher": (colour: (1.0, 0.5, 0.15), mark: "NL"),
        "Lava Gun": (colour: (1.0, 0.35, 0.1), mark: "LG"),
        "Annihilator": (colour: (0.92, 0.92, 0.88), mark: "AN"),
        "Flux Rifle": (colour: (0.7, 0.5, 1.0), mark: "FR"),
        "Infector": (colour: (0.45, 0.9, 0.3), mark: "IN"),
        "Spitting Hydra": (colour: (0.3, 0.75, 0.55), mark: "SH"),
        "Disc Blade Gun": (colour: (0.8, 0.85, 0.9), mark: "DB"),
        "Agents of Doom": (colour: (0.9, 0.3, 0.3), mark: "AD"),
        "Rift Inducer": (colour: (0.55, 0.3, 0.75), mark: "RI"),
        "Holo Shield Glove": (colour: (0.35, 0.9, 0.95), mark: "HS", shape: Some(Bar)),
        "Plasma Whip": (colour: (1.0, 0.6, 0.25), mark: "PW"),
        "Suck Cannon": (colour: (0.75, 0.6, 0.4), mark: "SC"),
        "Qwack-O-Ray": (colour: (1.0, 0.9, 0.2), mark: "QR"),
        "RY3NO": (colour: (1.0, 0.25, 0.2), mark: "R3", shape: Some(Diamond)),
        "Plasma Coil": (colour: (0.5, 0.55, 1.0), mark: "PC"),
        "Bouncer": (colour: (0.95, 0.65, 0.2), mark: "BO"),
        "Miniturret Glove": (colour: (0.6, 0.65, 0.7), mark: "MT", shape: Some(Square)),
        "Shield Charger": (colour: (0.4, 0.6, 1.0), mark: "CH", shape: Some(Ring)),
    },
)
