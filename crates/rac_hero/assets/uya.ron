// Ratchet's movement in Ratchet & Clank: Up Your Arsenal (NTSC-U, SCUS-97353), the hero
// kit's default tuning.
//
// Units: u/s and u/s², frame counts at 60 Hz. Turning springs are per tick (= per NTSC
// frame). Sources are sections of docs/research/hero-controller.md, with its labels:
// [verified] read in code and reproduced by traces, [code] read in code only,
// [measured] from traces only, [reported] from libuya/libdl. [placeholder] means not yet
// found in the game: a guess to be replaced.
(
    name: "UYA NTSC-U",
    body: (
        // "Differences between the games": libdl's HeroPlayerConstants capsule, which
        // Gladiator/DL read in their collision code [code].
        radius: 0.45,
        bottom: 0.7,
        bottom_airborne: 0.5,
        top: 1.05,
        // "Slope limit": the ground probe stands the hero on ground at most 0.8727 rad
        // steep [code].
        slope_limit_degrees: 50.0,
        ground_snap: 0.3, // [placeholder]
        // "Charge boots": DL caps the intended velocity at the collision radius less 0.02
        // a frame, 25.8 u/s; only the charge reaches it [measured on DL NTSC].
        max_step: 0.43,
    ),
    stick: (
        // "Input": per-axis dead zone and range [verified on R&C3 PAL], and the cut-off
        // below which the stick is ignored [verified on R&C3 PAL, code on UYA NTSC].
        dead_zone: 48.0,
        live_range: 76.0,
        cut_off: 0.25,
    ),
    walk: (
        // "Ground movement" [verified on UYA NTSC and R&C3 PAL].
        speed: 6.17,
        accel: 37.0,
        brake: 30.0, // stick pulled back to a lower target [code]
        setting_off_below: 2.5, // "about 2.5 u/s" [verified on R&C3 PAL]
        // Turning springs, UYA per-frame values [verified on R&C3 PAL, whose values are
        // these × 1.44 for gains and damping and × 1.2 for caps].
        turn_setting_off: (
            gain_per_m: 0.02,
            gain_min: 0.01,
            gain_max: 0.022,
            damping: 0.27,
            cap_per_m: 0.064,
            cap_min: 0.032,
            cap_max: 0.0931,
        ),
        turn_moving: (gain: 0.037, damping: 0.13, cap: 0.2036),
        // Skidding: the setting-off spring's damping with its own gain and cap [code].
        turn_skidding: (gain: 0.035, damping: 0.27, cap: 0.1949),
        // Letting go of the stick [verified on UYA NTSC].
        skid_brake: 17.0,
        // The skid state (3) brakes at 0.0075 u per frame, in UYA's and DL's code [code].
        skid_state_brake: 27.0,
        stop_skid_ticks: 2,
        stop_residual: 1.5,
        stop_brake: 17.7,
        // The walk's skid and slide, "Ground movement" [code, UYA NTSC; untraced].
        slide_below: 1.7, // 0.028333 u per frame
        slide_until_degrees: 5.0, // 0.08726646 rad
        skid_slow_degrees: 120.0, // 2.0943952 rad
        skid_swing_degrees: 110.0, // 1.9198622 rad, stick angle now against 6 frames ago
        skid_swing_ticks: 6,
        skid_swing_error_degrees: 70.0, // 1.2217305 rad
        skid_until_degrees: 4.0, // 0.06981317 rad
        skid_speed_loss: 5.5, // 0.091667 u per frame per π
        skid_scale_degrees: 150.0, // 2.6179938 rad
        skid_scale_min: 0.2,
        turn_slow_stick: 0.75,
        turn_slow_degrees: 35.0, // 0.61086524 rad
        turn_slow_per_radian: 0.4,
        turn_stall_stick: 0.9,
        turn_stall_degrees: 45.0,
        crouch_brake: 27.0, // [verified on UYA NTSC]
        // "Long jump", run or standing jump: picked by the stick, not the speed [code].
        run_jump_stick: 0.85,
        // A press in the last 7 frames (idle) or 9 (walking) still jumps [code].
        jump_buffer_idle: 7,
        jump_buffer_walk: 9,
    ),
    air: (
        // "Vertical model" and "Jump parameters by state" defaults [verified, apart from
        // the push-off speeds, which are code].
        pushoff_press: 48.0,
        pushoff_towards_cap: 20.0,
        pushoff_brake: 11.0,
        fall_speed_cap: 50.0,
        // "Air control" [verified on R&C3 PAL].
        control_accel: 20.0,
        control_factor_min: 1.0,
        control_factor_max: 3.0,
        release_below: 0.2,
        release_brake: 8.0,
        apex_below: 0.06, // 0.001 u per frame
        // Facing in the air: R&C3 PAL's gain 0.0576 and damping 0.288 ÷ 1.44 [code], and
        // the jump block's 0.25016 rad per frame cap [code].
        turn: (gain: 0.04, damping: 0.2, cap: 0.25016),
    ),
    fall: (
        // "Falling": gravity [measured on Gladiator PAL, code on R&C3 PAL], braking with
        // the stick released [code]. The fall's air speed is not read [placeholder].
        gravity: 22.0,
        air_speed: 6.17,
        release_brake: 7.0,
    ),
    // "Jump parameters by state", state 7 [verified on UYA NTSC].
    jump: (
        height_min: 1.42,
        height_max: 2.7,
        hold_ticks: 17,
        pushoff_ticks: 1,
        gravity: 29.7,
        apex_gravity_factor: 1.17,
        air_speed: 6.17,
    ),
    // State 9 [verified on UYA NTSC]. Its extra forward push during push-off is not
    // characterised and is left out.
    run_jump: (
        height_min: 1.42,
        height_max: 2.7,
        hold_ticks: 17,
        pushoff_ticks: 1,
        gravity: 29.7,
        apex_gravity_factor: 1.0,
        air_speed: 6.17,
    ),
    // State 10, "Long jump" [verified on UYA NTSC]. No air control: air_speed is unused.
    long_jump: (
        params: (
            height_min: 1.9,
            height_max: 1.95,
            hold_ticks: 14,
            pushoff_ticks: 5,
            gravity: 11.0,
            apex_gravity_factor: 1.0,
            air_speed: 0.0,
        ),
        // "Which jump a crouch gives" [code; the 7-frame crouch is verified on UYA NTSC:
        // the moves-1 long jump left a crouch at frame 7].
        min_speed: 0.9, // 0.015 u per frame
        min_stick: 0.7,
        forward_push: 0.88332, // 0.014722 u per frame per push-off frame
        crouch_ticks: 7,
        press_window: 9,
        from_jump_before_tick: 3,
        crouch_window: 2,
    ),
    // State 11, "Flips" [verified on UYA NTSC and Gladiator PAL].
    flip: (
        params: (
            height_min: 3.2,
            height_max: 3.25,
            hold_ticks: 14,
            pushoff_ticks: 1,
            gravity: 29.7,
            apex_gravity_factor: 1.0,
            air_speed: 5.5,
        ),
        speed: 5.5,
        min_speed: 2.0,
        start_speed: 5.0,
        accel: 47.0,
    ),
    // State 15, "Heli jump thrust" [verified on UYA NTSC].
    heli_jump: (
        params: (
            height_min: 1.65,
            height_max: 1.7,
            hold_ticks: 5,
            pushoff_ticks: 9,
            gravity: 29.7,
            apex_gravity_factor: 1.0,
            air_speed: 3.3,
        ),
        thrust: 49.0,
        thrust_from_tick: 35,
        thrust_to_tick: 70,
    ),
    // State 14, "Double jump" [verified on UYA NTSC; the height factors and when it can
    // start are code]. The speed holds for one tick after the boost: in the moves-1 trace
    // gravity resumes on the double jump's 10th frame.
    double_jump: (
        gravity: 29.7,
        boost_accel: 150.0,
        cap: 8.75,
        boost_ticks: 8,
        hold_ticks: 1,
        air_speed: 4.75,
        high_above: 2.2,
        high_factor: 0.7,
        higher_above: 2.8,
        higher_factor: 0.47,
        after_tick: 14,
        press_skip: 4,
        press_window_min: 2,
        press_window_max: 30,
        past_apex_min_height: 0.7,
        past_apex_max_speed: 5.8, // 0.09667 u per frame
    ),
    // State 8, "Glide": the sink [verified on UYA NTSC]; the spring is R&C3 PAL's gain
    // and damping ÷ 1.44, with its cap ÷ 1.2 and in u/s [code]; the forward motion [code].
    glide: (
        // Entered by holding X: in a double jump after its 30th tick and 1.5 u up, or in a
        // heli jump after its 85th and 0.6 u up [code; the moves-1 glide began on the
        // double jump's 31st frame].
        after_double_jump_tick: 30,
        double_jump_min_height: 1.5,
        after_heli_jump_tick: 85,
        heli_jump_min_height: 0.6,
        sink: 2.16,
        spring: (gain: 0.025, damping: 0.3, cap: 17.0),
        speed: 3.0,
        accel: 15.0,
        brake: 7.0,
    ),
    // State 17, "Wall jump" [code, UYA NTSC; untraced]. Ticks stand for the game's frame
    // counts, compared the way its transitions compare them ("t > 8" is from_tick 9).
    wall_jump: (
        params: (
            height_min: 1.8,
            height_max: 1.85,
            hold_ticks: 12,
            pushoff_ticks: 9, // spent clinging to the wall
            gravity: 29.0,
            apex_gravity_factor: 1.0,
            air_speed: 4.9,
        ),
        surface_height_min: 3.3,
        surface_height_max: 3.35,
        speed: 4.9, // 0.081667 u per frame along the wall's normal
        away_from_tick: 9,
        turn: (gain: 0.042, damping: 0.2, cap: 0.197804),
        turn_from_tick: 10,
        window_ticks: 6,
        press_window: 7,
        again_after_tick: 25,
        probe_height: 3.0,
        probe_height_chained: 1.7,
        probe_reach: 1.4,
        foot_probe_height: 0.2,
        max_distance: 0.72,
        max_distance_chained: 0.95,
        min_steepness_degrees: 75.0, // 1.3089969 rad
        max_facing_degrees: 50.0, // 0.87266463 rad
        min_turn_degrees: 170.0, // 2.9670596 rad
        min_height: 0.4,
        max_fall_speed: 20.0, // 0.33333 u per frame
        ordinary_chain: 2,
        ledge_lookahead_ticks: 20,
    ),
    // States 23-27, "Ledges" [code, UYA NTSC; untraced]. Rules the game times by
    // animation frame assume one frame per tick.
    ledge: (
        probe_above: 1.65, // 1.5 + 0.15
        probe_below: 1.15,
        probe_step: 0.075, // 0.3 × 0.25
        probe_tries: 4,
        max_top_slope_degrees: 20.0, // 0.34906584 rad
        min_rise: 0.5,
        max_rise: 1.5,
        min_drop: 1.8,
        clear_back: 1.0,
        face_below: 0.7,
        face_tries: 5,
        face_step: 0.14, // 0.7 / 5
        face_reach: 1.0,
        lip_step: 0.03,
        lip_search: 2.4,
        hang_out: 0.5,
        hang_below: 1.43,
        grab_rising_below: 3.5, // 0.058333 u per frame
        double_jump_after_tick: 37, // animation frame 37
        grab_speed: 4.0, // 0.066667 u per frame
        grab_turn: (gain: 0.04, damping: 0.2, cap: 0.10472),
        grab_ticks: 13, // hangs once the grab animation passes frame 12
        no_grab_ticks: 10,
        no_grab_ticks_shimmy: 40,
        climb_press_window: 17,
        shimmy_climb_press_window: 9,
        let_go_degrees: 135.0,
        shimmy_stick: 0.5,
        shimmy_degrees: 45.0,
        shimmy_probe: 0.3,
        // The game steps by a per-animation-frame table whose resulting speed isn't
        // traced yet [placeholder].
        shimmy_speed: 1.0,
        shimmy_turn: (gain: 0.02, damping: 0.2, cap: 0.0785398),
        // State 27, the ledge jump: 2.0-2.05 u, hold 1, push-off 4, gravity 25 [code].
        climb: (
            height_min: 2.0,
            height_max: 2.05,
            hold_ticks: 1,
            pushoff_ticks: 4,
            gravity: 25.0,
            apex_gravity_factor: 1.0,
            air_speed: 6.17,
        ),
        // Forward 0 until animation frame 13, then towards 2 u/s at 8 u/s² until 27, back
        // towards 0 until 30, then 0 [code].
        climb_forward_speed: 2.0,
        climb_forward_accel: 8.0,
        climb_forward_from_tick: 13,
        climb_forward_until_tick: 27,
        climb_forward_stop_tick: 30,
        climb_turn_after_tick: 40,
    ),
    // State 125, "Charge boots" [verified on DL NTSC, apart from the descent and the wall
    // probe, which are code]. UYA's single-player hero code
    // on Veldin has no charge state, so these are Deadlocked's. DL multiplies its
    // literals by frame_dt at run time, so they are per second already.
    charge: (
        tap_window: 15, // R1 pressed again within 15 frames
        cooldown_ticks: 30,
        speed: 30.0,
        fast_ticks: 60,
        // DL heads for 11.5 u/s once the fast part is over, which in single player is
        // the charge's last tick. A global that is 0 in single player makes it the whole
        // charge's target; probably multiplayer.
        late_speed: 11.5,
        accel: 100.0,
        brake: 15.0,
        last_tick: 60, // ends when the state's frame count reaches 61
        turn_rate: 1.2217305, // 70°/s
        turn_ramp_ticks: 50,
        turn_min_stick: 0.2,
        steer_step: 0.17,
        // DL holds the hero 0.17 u above the ground on this spring; the kit keeps his
        // feet on the ground and uses it only to sink after running off an edge
        // [simplified].
        descent_spring: (gain: 0.04, damping: 0.3),
        descent_cap: 7.5,
        end_lock_ticks: 30,
        blocked_below: 0.75,
        wall_probe_height: 1.0,
        wall_probe_reach: 1.25,
        // State 121, "jump bounce" [verified on DL NTSC; its gravity is code]. It lasts as
        // long as its animation, 54 frames [measured].
        bounce_speed: 9.0,
        bounce_brake: 24.0,
        bounce_gravity: 25.0,
        bounce_ticks: 54,
    ),
    // State 22, "Getting hit and dying" [code, UYA NTSC; untraced].
    hit: (
        max_speed: 7.0, // 0.11667 u per frame
        brake: 4.0,
        brake_later: 10.0,
        brake_later_from_tick: 11,
        ticks: 28,
        safe_ticks: 77,
        hazard_safe_ticks: 90,
        // The game's hazard damage is a per-level global, and its push comes from the
        // attacker; health is UYA's starting nanotech as remembered [placeholder].
        hazard_damage: 1,
        hazard_knockback: 4.0,
        hazard_lift: 6.0,
        max_health: 10,
    ),
    death: (
        ticks: 120, // [placeholder]: the death state's timing isn't read yet
    ),
    // camera.md, "How the follow camera works" [verified on UYA NTSC against
    // uyantsc-veldin-cam-1 where noted, otherwise code].
    camera: (
        distance: 4.64, // [verified]
        height: 2.0,
        look_height: 1.5,
        distance_spring: (gain: 0.003, damping: 0.2), // [verified]
        height_spring: (gain: 0.003, damping: 0.2),
        look_spring: (gain: 0.015, damping: 0.2), // [verified]
        look_spring_vertical: (gain: 0.0125, damping: 0.2),
        drag: 0.85, // [verified]
        arm_spring: (gain: 0.015, damping: 0.2), // yaw [verified]
        arm_length_spring: (gain: 0.02, damping: 0.2),
        arm_length_spring_approach: (gain: 0.04, damping: 0.3),
        approach_distance: 6.0,
        approach_full_speed: 4.2, // 0.07 u per frame
        approach_facing: -0.3,
        pitch_limit_degrees: 40.0, // 0.6981 rad
        pitch_step: 0.030543,
        // The game blends heights through a state machine not read yet; 0.1 u per frame
        // is its fastest blend rate [placeholder].
        landing_catch_up: 6.0,
        // The game pushes the camera out of geometry with a 0.25 u sphere; the kit casts
        // that sphere from the aim point instead [simplified].
        collision_radius: 0.25,
    ),
)
