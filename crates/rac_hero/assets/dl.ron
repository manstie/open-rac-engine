                    swing: [
                        (frame: 16.5, hand: (0.58, 0.15, 0.66), tip: (0.25, -0.75, 0.93)),
                        (frame: 17.0, hand: (0.59, 0.36, 0.62), tip: (0.51, -0.74, 0.86)),
                        (frame: 17.5, hand: (0.54, 0.52, 0.58), tip: (0.99, -0.59, 0.94)),
                        (frame: 18.0, hand: (0.44, 0.65, 0.53), tip: (1.62, -0.33, 1.04)),
                        (frame: 18.5, hand: (0.30, 0.74, 0.48), tip: (2.21, 0.47, 1.05)),
                        (frame: 19.0, hand: (0.14, 0.78, 0.44), tip: (2.25, 1.70, 0.88)),
                        (frame: 19.5, hand: (-0.02, 0.76, 0.42), tip: (1.57, 2.92, 0.61)),
                        (frame: 20.0, hand: (-0.16, 0.69, 0.41), tip: (0.12, 2.96, 0.37)),
                        (frame: 20.5, hand: (-0.21, 0.65, 0.41), tip: (-0.55, 2.50, 0.44)),
                        (frame: 21.0, hand: (-0.25, 0.60, 0.41), tip: (-1.06, 2.13, 0.50)),
                        (frame: 21.5, hand: (-0.29, 0.54, 0.41), tip: (-1.42, 1.64, 0.52)),
                        (frame: 22.0, hand: (-0.31, 0.49, 0.41), tip: (-1.63, 1.12, 0.52)),
                        (frame: 22.5, hand: (-0.33, 0.43, 0.41), tip: (-1.67, 0.59, 0.48)),
                        (frame: 23.0, hand: (-0.34, 0.37, 0.40), tip: (-1.58, 0.13, 0.41)),
                    ],
                ),
                // From behind, out ahead along the rail and round to his front.
                (
                    start_frame: 6.0, // sequence 71
                    blend_ticks: 4,
                    chain_before: 0.0,
                    buffer_from: 0.0,
                    chain_from: 14.0,
                    jump_from: 13.0,
                    end: 15.0,
                    hit_from: 8.0,
                    hit_to: 13.0,
                    lunge: [],
                    reach: None,
                    damage: 1.0,
                    knockback: 1.0,
                    push: Right,
                    head_radius: 0.7,
                    swing: [
                        (frame: 7.5, hand: (-0.23, 0.61, 0.47), tip: (-0.93, -0.21, 0.58)),
                        (frame: 8.0, hand: (-0.06, 0.72, 0.48), tip: (-1.09, 0.16, 0.54)),
                        (frame: 8.5, hand: (0.13, 0.75, 0.50), tip: (-1.12, 0.58, 0.47)),
                        (frame: 9.0, hand: (0.31, 0.71, 0.54), tip: (-1.09, 0.99, 0.37)),
                        (frame: 9.5, hand: (0.44, 0.58, 0.56), tip: (-0.91, 1.41, 0.27)),
                        (frame: 10.0, hand: (0.52, 0.40, 0.58), tip: (-0.54, 1.79, 0.20)),
                        (frame: 10.5, hand: (0.53, 0.19, 0.61), tip: (-0.01, 2.04, 0.19)),
                        (frame: 11.0, hand: (0.46, -0.01, 0.63), tip: (0.63, 2.11, 0.26)),
                        (frame: 11.5, hand: (0.34, -0.18, 0.64), tip: (1.31, 1.94, 0.40)),
                        (frame: 12.0, hand: (0.17, -0.28, 0.62), tip: (1.66, 1.22, 0.63)),
                        (frame: 12.5, hand: (0.14, -0.29, 0.61), tip: (1.68, 0.81, 0.65)),
                        (frame: 13.0, hand: (0.12, -0.30, 0.60), tip: (1.62, 0.42, 0.67)),
                    ],
                ),
            ],
            ball_ticks: 20,
            ball_radius: 1.0,
            ball_above: 0.6,
            ball_damage: 1.0,
            ball_knockback: 1.0,
            ball_push_degrees: 27.5, // [simplified]: the game draws 20°-35° at random
        ),
        // [code, 0x460530]: as UYA's, but the clank does no damage.
        clank: (
            after_tick: 10,
            within_degrees: 70.0,
            above: 0.5,
            reach: 1.4,
            shorten: 0.3,
            shorten_degrees: 105.0,
            damage: 0.0, // a touch of no damage [code]
            knockback: 1.0,
            ground_frame: 28.0, // [code]
            ground_above: 0.7,
            ground_below: 0.9,
        ),
    ),
    // A gun in hand, as UYA's (weapons.md, "The hero's side of firing") [not read in DL],
    // but for the release, which DL's trace with a gun in hand shows
    // (hero-controller.md, "Letting go of the walk with a gun in hand").
    gun: (
        steady_part_stick: 0.95,
        steady_part: (
            gain_per_m: 0.009,
            gain_min: 0.0,
            gain_max: 0.009,
            damping: 0.15,
            cap_per_m: 0.0785,
            cap_min: 0.0,
            cap_max: 0.0785,
        ),
        steady_full: (gain: 0.017, damping: 0.18, cap: 0.1454),
        stop_ticks: 1, // [verified on DL NTSC]
        fire_turn_scale: 3.0,
        fire_turn_ticks: 2,
        // UYA's [not read in DL]: hero_gun_arm_raise (0x4E26F8): the ray 0.57 u up (0.7 firing) from 0.02 inside
        // his radius to 1.3 u ahead; −70° × 1.25 × (1.3 − (d − radius)) / 1.3, kept to
        // 30°–70°; in lock-strafe the camera's pitch, 80° up to 45° down.
        raise: (
            height: 0.57,
            firing_height: 0.7,
            start_inside: 0.02,
            reach: 1.3,
            scale: 1.25,
            least: 30.0,
            most: 70.0,
            strafe_up: 80.0,
            strafe_down: 45.0,
        ),
    ),
    // State 22, "Getting hit and dying": DL's entry (0x69DAAC), motion and transitions
    // are UYA's apart from the marked values ("Deadlocked's hits") [code]. Death is as
    // UYA [not read in DL].
    hit: (
        max_speed: 7.0, // 0.11667 u per frame
        brake: 4.0,
        brake_later: 10.0,
        brake_later_from_tick: 11,
        ticks: 28,
        fall_after_tick: 16, // DL: the animation's frame 16, against UYA's 12.5
        fall_above: 1.0,
        // DL: hero+0x39C, 47 frames in lock-strafe and first person (the default), 70 in
        // third person, against UYA's 77. The kit doesn't vary it with the camera.
        safe_ticks: 47,
        // The damaging floor is UYA's under DL's numbers (0x672298): material 5 takes the
        // most health / 8 every 90 frames and enters state 144, 41 frames standing [code].
        hazard_safe_ticks: 90,
        hazard_divisor: 8,
        hazard_ticks: 41,
        max_health: 10, // [placeholder]
    ),
    death: (
        // [placeholder]: the hero reports his death 10 frames in, or once sequence 58 is
        // done and the state is 80 frames old, and the level respawns him ("Getting hit and
        // dying"); the respawn's timing wants a trace.
        ticks: 120,
    ),
    // camera.md, "Deadlocked's camera" [DL NTSC]: the follow camera is UYA's with its own
    // distance, so its sections are UYA's numbers [code: its functions pair up one for one
    // with UYA's]; the lock-strafe camera is read and traced in DL.
    camera: (
        default_setting: LockStrafe, // DL's default [verified]
        fov: 1.1100293, // 63.6°, first person included [measured, Dual Vipers]
        // DL: 6.0, which is also the push-back's far end, so running at the camera only
        // stiffens the length spring [code; 6.000 throughout dlntsc-dreadzone-cam-3].
        distance: 6.0,
        height: 2.0,
        look_height: 1.5,
        distance_spring: (gain: 0.003, damping: 0.2), // [verified]
        height_spring: (gain: 0.003, damping: 0.2),
        look_height_spring: (gain: 0.005, damping: 0.2),
        look_spring: (gain: 0.015, damping: 0.2), // [verified]
        look_spring_vertical: (gain: 0.0125, damping: 0.2),
        drag: 0.85, // [verified]
        arm_spring: (gain: 0.015, damping: 0.2), // yaw [verified]
        arm_length_spring: (gain: 0.02, damping: 0.2),
        arm_length_spring_approach: (gain: 0.04, damping: 0.3),
        approach_distance: 6.0,
        approach_full_speed: 4.2, // 0.07 u per frame
        approach_facing: -0.3,
        pitch_limit_degrees: 40.0, // 0.6981 rad
        pitch_step: 0.030543,
        // 0.0502 rad a frame at the default speed of 50, linear in the stick [verified in DL].
        stick_turn: 0.0218,
        stick_turn_per_speed: 0.0567,
        stick_tilt_dead_zone: 0.3, // [verified]
        stick_tilt_out: 0.02, // [verified]
        stick_tilt_back: 0.01,
        strafe_look_spring: (gain: 0.04, damping: 0.2),
        aim_blend_ticks: 90, // the value at 0x222810
        // 0x51E680, UYA's; the tilt [verified in DL] on a take without jumps.
        view: (
            min_across: 0.05,
            height_spring: (gain: 0.004, damping: 0.2),
            look_up_from: 0.1,
            look_up_peak_degrees: 15.0,
            look_up_spring: (gain: 0.005, damping: 0.2),
            pitch_cap_degrees: 70.0,
        ),
        vertical: (
            heli_rise: (height: 3.0, ticks: 85), // [verified]
            double_jump_rise: (height: 3.5, ticks: 45),
            flip_rise: (height: 1.0, ticks: 35), // [verified]
            rise_stop_radius: 0.2,
            land_ticks: 16.0,
            follow_down_above: 0.2,
            follow_down_angle: -0.01, // [verified]
            attack_air_ticks: 54,
            attack_after_ticks: 30,
            air_gain: 0.002, // [verified]
            air_gain_gap: 0.0105,
            air_gap: 2.0,
            air_after_land_ticks: 15,
        ),
        clearance: (
            ray_from: 0.5,
            ray_length: 20.0,
            // 0.35 + 0.1 × 7 at rest [verified under a low ceiling]
            radius: 1.05,
            height_gain: 0.006, // [verified]
        ),
        obstacles: (
            sweep: [(0.45, 0.45), (1.0, 0.55), (1.65, 0.65), (2.4, 0.75), (3.25, 0.85), (4.2, 0.95)],
            sweep_clear: 0.35,
            sweep_clear_along: 0.7,
            sweep_clear_scale: 0.75,
            end_skin: 0.005,
            wall_stick: 0.05,
            wall_pull: 0.075, // [verified]
            min_arm: 1.5,
            min_arm_wall: 0.2,
            pull_in_rest: 2000, // the cosine ease [verified]
            pull_in_wall: 2180,
            idle_stick: 0.3,
            reset_blocked_ticks: 30, // [verified]
            reset_distance: 30.0,
            reset_skin: 0.5,
        ),
        // The last push-out's sphere. The kit also sweeps it from the clearance point to
        // the camera, so the camera never ends up behind a wall [simplified].
        collision_radius: 0.25,
        // Locked on, the target steers the camera like the right stick, at up to
        // (ticks / 400) × π/2 rad a frame (0x3E42C0) [code, untraced].
        lock_turn: 1.5707964,
        lock_ramp_ticks: 400,
        lock_look_spring: (gain: 0.03, damping: 0.2),
        volume_gain: 0.001, // [verified on Florana]
        // "Lock-strafe, DL's default" and "First person" [verified in
        // dlntsc-dreadzone-cam-* and -camhalf-* where noted].
        free_look: (
            squared: false, // DL [verified at half tilt]
            yaw_speed: 0.05236, // DL: 180°/s [verified]
            yaw_accel: 0.0019393,
            pitch_speed: 0.034907, // 120°/s [verified]
            pitch_accel: 0.0014544,
            quick_stick: 0.99,
            quick_after_ticks: 2, // DL [verified]
            quick_speed: 0.10472, // 360°/s [verified]
            quick_accel: 0.0034907, // DL [verified]
            look_stick_threshold: 0.5, // as UYA [not read in DL]
            lock_strafe_limits: (down_degrees: 70.0, up_degrees: 70.0), // DL [code]
            first_person_limits: (down_degrees: 89.0, up_degrees: 85.0), // DL [verified]
            up_limit_rest_degrees: 70.0, // DL [verified]
            up_limit_ease_degrees: 2.0,
            hold_resets_limits: false, // DL [verified]
            first_person_lead_ticks: 10, // DL [measured]
            eye_lock_strafe: 2.0, // [verified]
            eye_first_person: 1.15, // DL [verified]
            eye_crouch: 1.0, // as UYA [not read in DL]
            eye_on_switch: None, // DL: at once both ways [verified]
            eye_accel: 0.0088889, // DL: 32 u/s² [code]
            eye_speed: 1.0666667,
            jump_hold_until: 3.5, // DL [verified]
            jump_hold_ledge: false, // DL [code]
            look_down_forward: 0.45, // [verified]
            eye_guard_from: 0.7, // as UYA [not read in DL]
            eye_guard_radius: 0.4,
            offset: 6.0, // [verified]
            offset_ray_extra: 0.5, // [verified]
            offset_accel: 0.0055556, // [verified]
            offset_speed: 0.3333333,
            end_sphere_radius: None, // DL has none [code]
            // UYA's aim assist [not read in DL].
            assist: Some((
                range: 30.0,
                hit_radius: 1.0,
                cone_degrees: 15.0,
                yaw_cut: 0.5,
                quick_cut: 0.0,
                pitch_cut: 0.6,
                quick_after_ticks: 10,
                quick_accel_share: 0.333,
                snap_stick: 0.85,
                snap_ticks: 7,
                strafe_yaw: 0.666,
                strafe_pitch: 0.85,
                strafe_cap: 0.1333333,
                strafe_turn_most: 0.0261799,
                strafe_fade: (4.0, 12.0),
            )),
        ),
        blends: (
            look_lead_ticks: 7, // as UYA [not read in DL]
            look_steer: 0.0698,
            look_reset_degrees: 80.0,
            into_look: (start: 0.0, rate: 0.075),
            out_of_look: (start: 0.25, rate: 0.018),
            into_lock_strafe: (start: 0.0, rate: 0.075),
            out_of_lock_strafe: (start: 0.0, rate: 0.075),
            out_of_first_person: (start: 0.25, rate: 0.075), // [verified in DL]
        ),
    ),
)
