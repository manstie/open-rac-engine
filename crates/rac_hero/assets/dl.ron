// Ratchet's movement in Ratchet: Deadlocked (NTSC-U, SCUS-97465).
//
// Units: u/s and u/s², frame counts at 60 Hz. Turning springs are per tick (= per NTSC
// frame). Sources are sections of docs/research/hero-controller.md, with its labels:
// [verified] read in code and reproduced by traces, [code] read in code only,
// [measured] from traces only, [reported] from libuya/libdl. [placeholder] means not yet
// found in the game: a guess to be replaced.
//
// DL's hero code is UYA's engine with its literals scaled by frame_dt at run time. It was
// compared with UYA's in DL's DreadZone Station overlay (2026-10-15; addresses in
// re/SCUS-97465/symbols.toml), and the traces dlntsc-dreadzone-moves-{1..5} check the
// walk, the jumps and the double jump. Values marked "DL:" differ from UYA's (uya.ron).
// Sections marked "as UYA [not read in DL]" keep UYA's numbers until DL's code for them
// is read; everything else was read the same in DL's code.
(
    name: "Deadlocked NTSC-U",
    body: (
        // "Differences between the games": libdl's HeroPlayerConstants capsule, which
        // Gladiator/DL read in their collision code [code].
        radius: 0.45,
        bottom: 0.7,
        bottom_airborne: 0.5,
        top: 1.05,
        // "Slope limit": the ground probe stands the hero on ground at most 0.8727 rad
        // steep [code].
        slope_limit_degrees: 50.0,
        ground_snap: 0.3, // [placeholder]
        // "Charge boots": DL caps the intended velocity at the collision radius less 0.02
        // a frame, 25.8 u/s; only the charge reaches it [measured on DL NTSC].
        max_step: 0.43,
    ),
    stick: (
        // "Input": the pad layer's dead zone and range are UYA's [verified on DL NTSC,
        // dlntsc-dreadzone-camhalf-0.5-1]. DL's hero code (0x6A9CE8) copies the stick
        // with no cut-off and no d-pad fallback, and takes its length as m [code; a stick
        // at 0.1974 stood still, by walk.start_above].
        dead_zone: 48.0,
        live_range: 76.0,
        cut_off: 0.0, // DL
        magnitude: Length, // DL
        // As UYA [not read in DL]: "Flips", the pad layer's flick. Only the crouch flip
        // reads it, and DL has none (walk.crouches).
        flick: (from: 0.25, to: 0.9, within_ticks: 3, swing_degrees: 55.0, swing_ticks: 4),
    ),
    walk: (
        // hero_transitions (0x69EA40): UYA's 0.22 and 0.17 [code], which with no cut-off
        // decide when a part-pushed stick walks.
        start_above: 0.22,
        keep_from: 0.17,
        // "Ground movement": DL's walk update (0x695CB8) and turn (0x67D100) hold UYA's
        // numbers apart from the speed [code; the speed and accel verified on DL NTSC].
        speed: 7.25, // DL: the walk speed global 0x3B01A0, libdl's maxWalkSpeed
        accel: 37.0,
        brake: 30.0, // stick pulled back to a lower target [code]
        setting_off_below: 2.5, // "about 2.5 u/s" [verified on R&C3 PAL]
        // Turning springs, UYA per-frame values [verified on R&C3 PAL, whose values are
        // these × 1.44 for gains and damping and × 1.2 for caps].
        turn_setting_off: (
            gain_per_m: 0.02,
            gain_min: 0.01,
            gain_max: 0.022,
            damping: 0.27,
            cap_per_m: 0.064,
            cap_min: 0.032,
            cap_max: 0.0931,
        ),
        turn_moving: (gain: 0.037, damping: 0.13, cap: 0.2036),
        // Skidding: the setting-off spring's damping with its own gain and cap [code].
        turn_skidding: (gain: 0.035, damping: 0.27, cap: 0.1949),
        // Letting go of the stick [verified on UYA NTSC]. With a gun in hand DL brakes one
        // tick at 30 and idles instead: the release skid depends on the held item, which
        // UYA's trace had as the wrench [measured on DL NTSC].
        skid_brake: 17.0,
        // The skid state (3) brakes at 0.0075 u per frame, in UYA's and DL's code [code].
        skid_state_brake: 27.0,
        stop_skid_ticks: 2,
        stop_residual: 1.5,
        stop_brake: 17.7,
        // The walk's skid and slide, "Ground movement" [code, UYA NTSC; untraced].
        slide_below: 1.7, // 0.028333 u per frame
        slide_until_degrees: 5.0, // 0.08726646 rad
        skid_slow_degrees: 120.0, // 2.0943952 rad
        skid_swing_degrees: 110.0, // 1.9198622 rad, stick angle now against 6 frames ago
        skid_swing_ticks: 6,
        skid_swing_error_degrees: 70.0, // 1.2217305 rad
        skid_until_degrees: 4.0, // 0.06981317 rad
        skid_speed_loss: 5.5, // 0.091667 u per frame per π
        skid_scale_degrees: 150.0, // 2.6179938 rad
        skid_scale_min: 0.2,
        turn_slow_stick: 0.75,
        turn_slow_degrees: 35.0, // 0.61086524 rad
        turn_slow_per_radian: 0.4,
        turn_stall_stick: 0.9,
        turn_stall_degrees: 45.0,
        // DL: no code enters the crouch (state 4); R1's pad bit is worked out and ignored
        // where UYA crouches ("Deadlocked's moves") [code; R1 traced]. The crouch's numbers
        // below are UYA's, unused.
        crouches: false,
        crouch_brake: 27.0,
        crouch_turn: (gain: 0.002, damping: 0.07, cap: 0.165806),
        crouch_turn_stick: 0.2,
        // "Long jump", run or standing jump: picked by the stick, not the speed [code].
        run_jump_stick: 0.85,
        // A press in the last 7 frames (idle) or 9 (walking) still jumps [code].
        jump_buffer_idle: 7,
        jump_buffer_walk: 9,
    ),
    air: (
        // "Vertical model" and "Jump parameters by state" defaults, read the same in DL's
        // jump entry (0x699C70), jump update (0x696620) and air control (0x680A88) [code;
        // the vertical model verified on DL NTSC].
        pushoff_press: 48.0,
        pushoff_towards_cap: 20.0,
        pushoff_brake: 11.0,
        fall_speed_cap: 50.0,
        // "Air control" [verified on R&C3 PAL].
        control_accel: 20.0,
        control_factor_min: 1.0,
        control_factor_max: 3.0,
        // The speed asked for against 0.2 of the walk speed (0x4EDE80) [code].
        release_below: 0.2,
        release_brake: 8.0,
        apex_below: 0.06, // 0.001 u per frame
        // Facing in the air: R&C3 PAL's gain 0.0576 and damping 0.288 ÷ 1.44 [code], and
        // the jump block's 0.25016 rad per frame cap [code].
        turn: (gain: 0.04, damping: 0.2, cap: 0.25016),
        // "Flips", the landing with the stick released: 0.2 and 0.041666668 u per frame in
        // DL's jump states' landing too (0x6A413C) [code].
        land_release_stick: 0.2,
        land_release_speed: 2.5,
    ),
    fall: (
        // "Falling": gravity [measured on Gladiator PAL, code on DL NTSC], braking with
        // the stick released [code].
        gravity: 22.0,
        air_speed: 7.25, // DL: it steers to the walk's speed target (0x67CAF8) [code]
        release_brake: 7.0,
        // Coming down: UYA's [not read in DL].
        landing: (
            far_after_ticks: 17,
            far_above: 1.75,
            walk_stick: 0.5,
            skid_above: 3.0,
            lock_ticks: 7,
            long_after_ticks: 50,
            long_lock_ticks: 18,
            longer_after_ticks: 90,
            longer_lock_ticks: 22,
        ),
    ),
    // "Jump parameters by state", state 7 [verified on DL NTSC: held fully, a jump peaks
    // 1.8865 u up].
    jump: (
        height_min: 1.42,
        height_max: 2.7,
        hold_ticks: 17,
        pushoff_ticks: 1,
        gravity: 29.7,
        apex_gravity_factor: 1.17,
        air_speed: 7.25, // DL: the jump block's default, the walk speed
    ),
    // State 9 [verified on DL NTSC: 7.25 u/s in the air]. Its extra forward push during
    // push-off is not characterised and is left out.
    run_jump: (
        height_min: 1.42,
        height_max: 2.7,
        hold_ticks: 17,
        pushoff_ticks: 1,
        gravity: 29.7,
        apex_gravity_factor: 1.0,
        air_speed: 7.25, // DL
    ),
    // State 10, "Long jump": DL's state entry sets UYA's numbers [code], but nothing enters
    // it: it starts from a crouch, which DL hasn't (walk.crouches), and the R1 check in a
    // jump's first frames is ignored (0x6A3D88). The entry rules below are UYA's, unused.
    long_jump: (
        params: (
            height_min: 1.9,
            height_max: 1.95,
            hold_ticks: 14,
            pushoff_ticks: 5,
            gravity: 11.0,
            apex_gravity_factor: 1.0,
            air_speed: 0.0,
        ),
        // "Which jump a crouch gives" [code; the 7-frame crouch is verified on UYA NTSC:
        // the moves-1 long jump left a crouch at frame 7].
        min_speed: 0.9, // 0.015 u per frame
        min_stick: 0.7,
        forward_push: 0.88332, // 0.014722 u per frame per push-off frame
        crouch_ticks: 7,
        press_window: 9,
        from_jump_before_tick: 3,
        crouch_window: 2,
    ),
    // State 11, "Flips": DL's state entry sets UYA's numbers [code; the speed verified on
    // Gladiator PAL]. DL's walk never flips (strafe.flips): its only flip is the landing
    // flip (strafe.landing_window) [verified on DL NTSC].
    flip: (
        params: (
            height_min: 3.2,
            height_max: 3.25,
            hold_ticks: 14,
            pushoff_ticks: 1,
            gravity: 29.7,
            apex_gravity_factor: 1.0,
            air_speed: 5.5,
        ),
        speed: 5.5,
        min_speed: 2.0,
        start_speed: 5.0,
        accel: 47.0,
        // As UYA [not read in DL]: the strafe flip's stick. The crouch flip is UYA's,
        // unused: DL has no crouch, and the flip from a jump still on the ground ignores
        // R1 (0x6A3D28) [code].
        strafe_stick: 0.3,
        crouch: (
            press_gap: 12,
            crouch_window: 17,
            early_window: 5,
            early_before_tick: 12,
            speed: 4.2,
            accel: 8.0,
            slow_within_ticks: 11,
            carry_above: 1.5,
            facing_ticks_back: 10,
            turn: (gain: 0.04, damping: 0.2, cap: 0.116355),
            edge_from_tick: 13,
            edge_height: 3.0,
            edge_near: 0.57,
            edge_far: 5.5,
            edge_rise: 2.0,
            edge_drop: 3.0,
        ),
    ),
    // Strafing, the walk with L2 or R2 held in DL's third-person camera, and always in
    // its lock-strafe camera but with the wrench. The walk's speeds apply [verified on DL
    // NTSC]; the turn is UYA's (0x67BDE0) [verified]. The sides and the side change
    // (0x67C5F8, 0x67BEC0) differ ("Deadlocked's strafing") [code].
    strafe: (
        turn: (gain: 0.042, damping: 0.25, cap: 0.319977),
        reverse_ticks: 3,
        reverse_eases: false, // DL: (3 - timer) / 3 in integers, so 0
        back_degrees: 60.0, // DL
        // DL: 0x687430 works out the flip, then always jumps (state 7). Strafing sideways
        // and back with X gave standing jumps (dlntsc-dreadzone-moves-2) [verified].
        flips: false,
        flip_stick: 0.9, // the landing flip's 0x3F666666 (0x6A4600) [code]
        // "The landing flip" (0x6A45F0): DL's only flip. X within 8 frames, on the frame a
        // jump lands and the next [code; verified on DL NTSC, dlntsc-dreadzone-flip-1:
        // presses 2, 6 and 7 frames old flipped, one 9 frames old didn't].
        landing_window: 8,
        landing_ticks: 2,
        back_stick: 0.05, // DL
        idle_within_degrees: 2.0,
        turn_after_degrees: 10.0, // camera.md, "Lock-strafe, DL's default" [verified on DL NTSC]
    ),
    // "Deadlocked's lock-on" [code, DL NTSC, 2026-10-23]: DL's hero_lock_on (0x688410)
    // keeps and drops a target by UYA's rules but never picks one, and only multiplayer
    // levels' guns set one, so the campaign never locks on. Both triggers still strafe.
    // The search and sight are UYA's, unused.
    lock_on: (
        enabled: false, // DL
        aim: (range: 25.0, cone_degrees: 35.0, rise_degrees: 70.0),
        sight_height: 0.7,
        sight_short: 0.75, // [simplified]
        keep_range: 30.0,
    ),
    // State 15, "Heli jump thrust": DL's state entry and its thrust table (0x2207D0, 49
    // u/s² from frame 35 to 70) are UYA's [code], but nothing enters it: DL has no crouch.
    heli_jump: (
        params: (
            height_min: 1.65,
            height_max: 1.7,
            hold_ticks: 5,
            pushoff_ticks: 9,
            gravity: 29.7,
            apex_gravity_factor: 1.0,
            air_speed: 3.3,
        ),
        thrust: 49.0,
        thrust_from_tick: 35,
        thrust_to_tick: 70,
    ),
    // State 14, "Double jump" (DL's 0x6804C8 and 0x6A48D8) [verified on DL NTSC: the cap,
    // and a press on the jump's 9th frame waiting to its 11th; the height factors are
    // code]. Past the apex a press 5.2 u/s down was refused: the game compares the speed
    // after the tick's gravity.
    double_jump: (
        gravity: 29.7,
        boost_accel: 150.0,
        cap: 7.0, // DL: 7 u/s, without UYA's × 1.25
        boost_ticks: 8,
        hold_ticks: 1,
        air_speed: 4.75,
        high_above: 2.2,
        high_factor: 0.7,
        higher_above: 2.8,
        higher_factor: 0.47,
        after_tick: 10, // DL: from t > 10, against UYA's t > 14
        press_skip: 4,
        press_window_min: 2,
        press_window_max: 30,
        past_apex_min_height: 0.7,
        past_apex_max_speed: 5.8, // 0.09667 u per frame
    ),
    // State 8, "Glide": DL's update (in 0x690F18) [code]. DL never glides: where UYA checks
    // the heli-pack, DL checks hero+0x2E2C, which the hero is created with set and nothing
    // clears ("Deadlocked's moves") [code; traced]. In the kit that is Abilities::heli_pack
    // off, which a DL game sets and the demo doesn't. The double and heli jumps' limits for
    // it read the same in DL (0x6A4A44) [code].
    glide: (
        // Entered by holding X: in a double jump after its 30th tick and 1.5 u up, or in a
        // heli jump after its 85th and 0.6 u up [code; the moves-1 glide began on the
        // double jump's 31st frame].
        after_double_jump_tick: 30,
        double_jump_min_height: 1.5,
        after_heli_jump_tick: 85,
        heli_jump_min_height: 0.6,
        sink: 3.6, // DL: 5 u/s × 0.72, against UYA's 3 u/s × 0.72
        spring: (gain: 0.025, damping: 0.3, cap: 17.0),
        speed: 5.0, // DL: always 5 u/s; UYA glides at 3, and 5 in one gadget mode
        accel: 15.0,
        brake: 7.0,
    ),
    // State 17, "Wall jump": DL has none. Its state entry, and the turn and 4.9 u/s away
    // from the wall in its air control (0x680A88), are UYA's, but nothing enters the
    // state and no wall detector runs ("Deadlocked's moves") [code]. The numbers below are
    // UYA's, unused.
    wall_jump: (
        enabled: false, // DL
        params: (
            height_min: 1.8,
            height_max: 1.85,
            hold_ticks: 12,
            pushoff_ticks: 9, // spent clinging to the wall
            gravity: 29.0,
            apex_gravity_factor: 1.0,
            air_speed: 4.9,
        ),
        surface_height_min: 3.3,
        surface_height_max: 3.35,
        speed: 4.9, // 0.081667 u per frame along the wall's normal
        away_from_tick: 9,
        turn: (gain: 0.042, damping: 0.2, cap: 0.197804),
        turn_from_tick: 10,
        window_ticks: 6,
        press_window: 7,
        again_after_tick: 25,
        probe_height: 3.0,
        probe_height_chained: 1.7,
        probe_reach: 1.4,
        foot_probe_height: 0.2,
        max_distance: 0.72,
        max_distance_chained: 0.95,
        min_steepness_degrees: 75.0, // 1.3089969 rad
        max_facing_degrees: 50.0, // 0.87266463 rad
        min_turn_degrees: 170.0, // 2.9670596 rad
        min_height: 0.4,
        max_fall_speed: 20.0, // 0.33333 u per frame
        ordinary_chain: 2,
        ledge_lookahead_ticks: 20,
    ),
    // States 23-27, "Ledges": DL's detector (0x672960), the states' motion (0x690F18) and
    // transitions (0x69EA40), and the climb's state entry and air control, read
    // ("Deadlocked's ledges") [code; untraced in DL]. Rules the game times by animation
    // frame assume one frame per tick.
    ledge: (
        probe_above: 1.65, // 1.5 + 0.15
        probe_below: 1.15,
        // DL: one cast, 0.3 + 0.3 past the capsule's front, for the local player (IsLocal,
        // hero+0x266D); other players' heroes try four times 0.3 apart, from 2.4 above to
        // 1.9 below, while not jumping.
        probe_ahead: 0.3,
        probe_step: 0.3,
        probe_tries: 1,
        max_top_slope_degrees: 20.0, // 0.34906584 rad
        min_rise: 0.5,
        max_rise: 1.5,
        min_drop: 1.8,
        clear_back: 0.0, // DL: no clear-lip check
        face_below: 0.7,
        face_tries: 5,
        face_step: 0.14, // 0.7 / 5
        face_reach: 1.0,
        lip_step: 0.03,
        lip_search: 2.4,
        // DL: the search's probe is 0.03 out and 0.05 below at both ends (0x6730D0), so
        // it never hits and the lip stays where the cast hit the top, 1.05 u ahead of the
        // feet. The hang point is then 0.55 u ahead of his axis, so the wall holds him at
        // its face [code; verified on DL NTSC, 2026-10-20: lip = the cast's hit, hanging
        // 0.49 u short of the hang point].
        lip_walk: false,
        hang_out: 0.5,
        hang_below: 1.43,
        grab_rising_below: 0.5, // DL: 0.5 × frame_dt, against UYA's 3.5 u/s
        double_jump_after_tick: 24, // DL: animation frame 24, against UYA's 37
        grab_speed: 4.0, // 0.066667 u per frame
        grab_turn: (gain: 0.04, damping: 0.2, cap: 0.10472),
        // DL: the grab's animation starts at keyframe 1 (UYA 11), so it passes frame 12 on
        // tick 23 [verified on DL NTSC, 2026-10-20]; at keyframe 0, 25, when the grab comes
        // faster than 3.5 u/s (hero+0x1B4) [code].
        grab_ticks: 23,
        no_grab_ticks: 10, // [verified on DL NTSC: L2, or X with the stick pulled away]
        no_grab_ticks_shimmy: 40,
        no_grab_ticks_lost: 30, // DL: 30, against UYA's 10
        climb_press_window: 17,
        shimmy_climb_press_window: 9,
        let_go_degrees: 135.0,
        shimmy_stick: 0.5,
        shimmy_degrees: 45.0,
        shimmy_probe: 0.3,
        // The shimmy steps by its animation's table, as UYA's: towards the ledge found 0.2 u
        // to the side, 1.5 × the frame's entry long (0x3B0BA0, UYA 0.5 ×). That ledge's
        // hang point is 0.55 u ahead of his axis (`lip_walk`), further than the wall lets
        // him come, so it takes all but 0.342 of each step: along the wall a step is
        // 0.513 × the entry, about UYA's pace. The steps
        // back pull him 0.29 u off the wall each cycle, and the next steps forward put him
        // back. The animation runs half a frame a tick from the first tick and loops over
        // 16 frames, so a cycle is 32 ticks and covers 0.60 u [verified on DL NTSC,
        // 2026-10-20: 0.605 and 0.600 u a cycle].
        shimmy_look: 0.2,
        shimmy_steps: [0.0, 0.0, 0.025, 0.05, 0.075, 0.162, 0.162, 0.107, 0.037, 0.037, 0.037, -0.017, -0.017, -0.035, -0.035],
        shimmy_step_scale: 1.5,
        shimmy_blend_ticks: 0,
        shimmy_frames_per_tick: 0.5,
        shimmy_cycle_frames: 16.0,
        shimmy_turn: (gain: 0.02, damping: 0.2, cap: 0.0785398),
        // State 27, the ledge jump: 2.0-2.05 u, hold 1, push-off 2, gravity 25 [code;
        // verified on DL NTSC, 2026-10-20: off on the 4th tick, peaking 1.967 u above the
        // hanging feet].
        climb: (
            height_min: 2.0,
            height_max: 2.05,
            hold_ticks: 1,
            pushoff_ticks: 2, // DL: 2 frames, against UYA's 4
            gravity: 25.0,
            apex_gravity_factor: 1.0,
            air_speed: 7.25, // DL: the jump block's default
        ),
        // The game moves forward towards 2 u/s at 8 u/s² between the climbing animation's
        // frames 13 and 27, back towards 0 until 30, and leaves the speed alone outside
        // them [code]. DL's climb starts its animation at keyframe 14, so the speed rises
        // from its first tick and reaches 2 u/s on its 15th; the animation passed 27 on
        // the 38th, where it eased off as he landed [verified on DL NTSC, 2026-10-20; the
        // wall kept him from moving forward until the 8th tick].
        climb_forward_speed: 2.0,
        climb_forward_accel: 8.0,
        climb_forward_from_tick: 0,
        climb_forward_until_tick: 36,
        climb_forward_stop_tick: 39,
        climb_turn_after_tick: 40,
    ),
    // State 125, "Charge boots" [verified on DL NTSC, apart from the descent and the wall
    // probe, which are code]. DL multiplies its literals by frame_dt at run time, so they
    // are per second already.
    charge: (
        tap_window: 15, // R1 pressed again within 15 frames
        cooldown_ticks: 30,
        speed: 30.0,
        fast_ticks: 60,
        // DL heads for 11.5 u/s once the fast part is over, which in single player is
        // the charge's last tick. A global that is 0 in single player makes it the whole
        // charge's target; probably multiplayer.
        late_speed: 11.5,
        accel: 100.0,
        brake: 15.0,
        last_tick: 60, // ends when the state's frame count reaches 61
        turn_rate: 1.2217305, // 70°/s
        turn_ramp_ticks: 50,
        turn_min_stick: 0.2,
        steer_step: 0.17,
        // DL holds the hero 0.17 u above the ground on this spring; the kit keeps his
        // feet on the ground and uses it only to sink after running off an edge
        // [simplified].
        descent_spring: (gain: 0.04, damping: 0.3),
        descent_cap: 7.5,
        end_lock_ticks: 30,
        blocked_below: 0.75,
        wall_probe_height: 1.0,
        wall_probe_reach: 1.25,
        // State 121, "jump bounce" [verified on DL NTSC; its gravity is code]. It lasts as
        // long as its animation, 54 frames [measured].
        bounce_speed: 9.0,
        bounce_brake: 24.0,
        bounce_gravity: 25.0,
        bounce_ticks: 54,
    ),
    // States 39-41 and 63, "Deadlocked's grinding" [code]: the jumps (40, 41), the turn
    // and the rail's end as UYA; getting on, the switch's search and the speed as UYA [not
    // read in DL]. Per-frame values are given as UYA's code has them.
    grind: (
        reach: 0.9,
        reach_on_ground: 0.3,
        reach_vertical: 1.5,
        below: 0.5,
        above: 0.57,
        no_rail_ticks: 8,
        speed: 12.0, // 0.2 u per frame
